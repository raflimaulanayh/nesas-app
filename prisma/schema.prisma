generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

model Users {
  id              String          @id @default(cuid())
  username        String?
  email           String?         @unique
  emailVerified   DateTime?
  password        String
  role            String          @default("student")
  photo           String?
  accountComplete Boolean?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  active          Boolean?        @default(false)
  Account         Account[]
  Articles        Articles[]
  ForumComments   ForumComments[]
  Forums          Forums[]
  students        Students?
  teachers        Teachers?
}

model Account {
  id                String  @id @default(cuid())
  user_id           String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             Users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([user_id])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Teachers {
  id               String                 @id @default(cuid())
  user_id          String?                @unique
  nip              String?                @unique
  name             String?
  gender           GenderType?
  birth_date       String?
  phone_number     String?
  address          String?
  join_date        String?
  end_date         String?
  proof            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             Users?                 @relation(fields: [user_id], references: [id])
  teacherPositions EducationalPositions[] @relation("EducationalPositionsToTeachers")

  @@index([user_id])
}

model EducationalPositions {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  major     Majors[]   @relation("EducationalPositionsToMajors")
  teachers  Teachers[] @relation("EducationalPositionsToTeachers")
}

model Majors {
  id                   String                 @id @default(cuid())
  long_name            String
  short_name           String
  logo                 String?
  description          String?
  content              String?
  image                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  classes              Classes[]
  companyInternships   CompanyInternships[]   @relation("CompanyInternshipsToMajors")
  educationalPositions EducationalPositions[] @relation("EducationalPositionsToMajors")
}

model Classes {
  id        String     @id @default(cuid())
  name      String
  major_id  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  major     Majors?    @relation(fields: [major_id], references: [id], onDelete: SetNull, onUpdate: SetNull)
  students  Students[]

  @@index([major_id])
}

model Students {
  id                  String          @id @default(cuid())
  user_id             String?         @unique
  nis                 String?         @unique
  nisn                String?         @unique
  name                String
  gender              GenderType?
  class_id            String?
  birth_date          String?
  phone_number        String?
  phone_number_parent String?
  address             String?
  join_date           String?
  end_date            String?
  graduate_status     GraduateStatus? @default(ongoing)
  internship_id       String?
  proof               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  class               Classes?        @relation(fields: [class_id], references: [id], onDelete: Restrict)
  internship          Internships?    @relation(fields: [internship_id], references: [id], onDelete: SetNull)
  user                Users?          @relation(fields: [user_id], references: [id])

  @@index([class_id])
  @@index([user_id])
  @@index([internship_id])
}

model Internships {
  id                 String              @id @default(cuid())
  company_id         String?
  start_date         String?
  end_date           String?
  status             InternshipStatus    @default(not_started)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  companyInternships CompanyInternships? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  students           Students[]

  @@index([company_id])
}

model CompanyInternships {
  id           String        @id @default(cuid())
  name         String
  address      String?
  contact      String?
  leader_name  String?
  status       CompanyStatus @default(not_active)
  quota        Int?
  requirements String?
  signature    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  internships  Internships[]
  majors       Majors[]      @relation("CompanyInternshipsToMajors")
}

model UserActivities {
  id              String           @id @default(cuid())
  identifier      String?
  type_activity   TypeUserActivity
  activity_detail String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Articles {
  id            String     @id @default(cuid())
  user_id       String?
  title         String
  description   String?
  content       String
  keyword       String?
  category      String?
  picture       String?
  status        PostStatus
  like_count    Int?
  dislike_count Int?
  view_count    Int?
  slug          String?    @unique
  writer_name   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          Users?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
}

model Contacts {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phoneNumber String
  subject     String?
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Forums {
  id            String          @id @default(cuid())
  user_id       String
  title         String
  content       String?
  like_count    Int?
  dislike_count Int?
  view_count    Int?
  status        PostStatus      @default(public)
  slug          String          @unique
  keyword       String?
  solved        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ForumComments ForumComments[]
  users         Users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ForumComments {
  id            String   @id @default(cuid())
  forum_id      String
  user_id       String
  content       String?
  like_count    Int?
  dislike_count Int?
  view_count    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  forums        Forums   @relation(fields: [forum_id], references: [id], onDelete: Cascade)
  users         Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum CompanyStatus {
  active
  not_active
  pending
  filled
}

enum InternshipStatus {
  not_started
  pending
  approved
  rejected
  canceled
  dropoff_completed
  ongoing
  pickup_completed
  completed
  interviewing
  getted_kuota
  sidang_completed
}

enum GraduateStatus {
  ongoing
  graduated
  dropout
  transferred
}

enum GenderType {
  male
  female
}

enum TypeUserActivity {
  signin
  signout
  create
  update
  delete
  others
}

enum PostStatus {
  public
  private
  draft
  pending
}
